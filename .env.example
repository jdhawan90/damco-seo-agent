# ============================================================================
# Damco SEO AI Agent System — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# ---- Tenant -------------------------------------------------------------------
# Which client this deployment runs for. The profile itself — brand name,
# owned domains, service lines, market, vocabularies, tuned thresholds — lives
# in the `tenants` / `tenant_domains` / `tenant_offerings` /
# `tenant_vocabularies` / `tenant_policies` tables (migration 012), NOT here.
# Agents read it through common/tenant.py; no agent hardcodes client data.
#
# Leave TENANT_SLUG unset for the normal case: one client per database, and
# the single active tenant row is resolved automatically. Set it only if a
# database ever holds more than one.
#TENANT_SLUG=damco

# ---- Database ---------------------------------------------------------------
# Local PostgreSQL. Change host/port when deploying to cloud.
DATABASE_URL=postgresql://damco_seo:CHANGE_ME@localhost:5432/damco_seo
# Optional pool sizing (defaults: min 1, max 5).
DB_POOL_MIN=1
DB_POOL_MAX=5

# Read-only connection for the dashboard chat's SQL fallback. That query text is
# model-authored and never reviewed by a human before it runs, so it must not go
# through the application user, which can INSERT, UPDATE and DROP.
#
# Create the role first (needs superuser):
#   psql -U postgres -d damco_seo -v pw="'...'" -f sql/roles/create_readonly_role.sql
#   python sql/migrate.py            # applies the SELECT grants
#
# Leave unset and the chat still works — it just answers only what its typed
# tools cover, and declines anything needing ad-hoc SQL.
DATABASE_URL_READONLY=

# ---- DataForSEO -------------------------------------------------------------
# https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=your_login_here
DATAFORSEO_PASSWORD=your_password_here
# Default queue: "standard" (cheap, async ~1-5 min) or "live" (expensive, sync).
DATAFORSEO_DEFAULT_QUEUE=standard
# Default SERP location, language and device. These are FALLBACKS — the
# tenant profile (migration 012) carries the authoritative per-client market,
# and agents should pass it explicitly. Anything reading these directly is
# assuming every client sells in the same country.
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_DEVICE=desktop
#
# Google Ads Keyword Planner: no separate credentials needed. DataForSEO's
# /keywords_data/google_ads/* endpoints proxy the real Keyword Planner API
# (same volumes, same 12-month monthly_searches arrays) without requiring a
# Google Ads developer token, which needs an approved MCC account and a
# manual review. common.connectors.dataforseo.get_search_volume() is the
# single entry point; agents should not build their own Google Ads client.

# ---- Google Search Console (OAuth 2.0) --------------------------------------
# OAuth client created in Google Cloud Console. Token file is generated on first run.
GSC_CLIENT_SECRETS_FILE=./secrets/gsc_client_secrets.json
GSC_TOKEN_FILE=./secrets/gsc_token.json
GSC_SITE_URL=https://www.damcogroup.com/

# ---- PageSpeed Insights -----------------------------------------------------
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=your_key_here

# ---- Anthropic (Claude API) -------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Default model tier: haiku for cheap routine tasks, sonnet for most, opus for complex.
CLAUDE_MODEL_CHEAP=claude-haiku-4-5-20251001
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_COMPLEX=claude-opus-4-6

# ---- Embeddings (optional) ----------------------------------------------------
# Used for semantic similarity — currently trend_scout's novelty check, which
# decides whether a discovered phrase is genuinely new or a paraphrase of a
# keyword we already pay to track. Anthropic has no embeddings endpoint;
# Voyage is their recommended partner. https://dash.voyageai.com/
#
# Leave unset and everything still works: the novelty check falls back to
# token-set matching and says so in the run output. Cost is negligible —
# roughly $0.02 to embed the whole tracked keyword set once, then fractions
# of a cent per run, because vectors are cached in `keyword_embeddings`.
VOYAGE_API_KEY=

# Per-process Claude spend ceiling in USD. Raises LLMBudgetExceeded (a subclass
# of LLMUnavailableError, so existing fallbacks catch it) once reached. Set to
# 0 to disable. Not a substitute for billing alerts — it exists so a bug in a
# loop costs cents rather than the balance.
#LLM_BUDGET_USD=5

# ---- Notifications (optional, for agents that alert) ------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=seo-agents@damcogroup.com

# ---- Runtime ----------------------------------------------------------------
# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Base directory for generated outputs (PDFs, reports, drafts). Relative to repo root.
OUTPUTS_DIR=./outputs
